<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.kengjer.applytrack.AddApplicationController"
            fitToWidth="true"
            prefHeight="650.0"
            prefWidth="600.0">

    <content>
        <VBox spacing="12.0"
              prefWidth="480.0">

            <padding>
                <Insets top="30.0"
                        right="60.0"
                        bottom="30.0"
                        left="60.0"/>
            </padding>

            <Label fx:id="formTitleLabel"
                   text="Add Application" />

            <Label text="Company" />
            <TextField fx:id="companyField"
                       promptText="Enter company name" />

            <Label text="Position" />
            <TextField fx:id="positionField"
                       promptText="Enter position title" />

            <Label text="Category" />
            <ComboBox fx:id="categoryComboBox"
                      promptText="Select category" />

            <Label text="Status" />
            <ComboBox fx:id="statusComboBox"
                      promptText="Select status" />

            <Label text="Application Date" />
            <DatePicker fx:id="applicationDatePicker"
                        promptText="Select application date" />

            <Label text="Source" />
            <TextField fx:id="sourceField"
                       promptText="Enter application source" />

            <Label text="Follow-up Date" />
            <DatePicker fx:id="followUpDatePicker"
                        promptText="Select follow-up date" />

            <Label text="Notes" />
            <TextArea fx:id="notesArea"
                      promptText="Enter notes"
                      prefRowCount="3" />

            <Label fx:id="errorLabel"
                   text=""
                   wrapText="true" />

            <HBox spacing="12.0">
                <Button text="Cancel"
                        onAction="#handleCancel" />
                <Button text="Save"
                        onAction="#handleSave" />
            </HBox>

        </VBox>
    </content>

</ScrollPane>